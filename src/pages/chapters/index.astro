---
import { getAllChapters, getAllChaptersUrl } from "@/utils/content";
import PageLayout from "@/layouts/PageLayout.astro";
import ChapterFeed from "@/components/content/ChapterFeed.astro";
import PageHeader from "@/components/PageHeader.astro";

const chapters = await getAllChapters();
const title = "Chapters";
const description = "Browse all published chapters.";
---
<PageLayout
  title={title}
  description={description}
  showHeader={false}
>

  <PageHeader {title} subheading={description}>
    <a slot="meta" href={getAllChaptersUrl()} class="font-ui text-xs link-hover">
      Read on a single page
    </a>
  </PageHeader>

  <ChapterFeed
    chapters={chapters}
    variant="timeline"
  />
</PageLayout>
