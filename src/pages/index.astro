---
import siteConfig from '@/site.config';
import BaseLayout from "@/layouts/BaseLayout.astro";
import SEO from "@/components/SEO.astro";
import { getAllChapters, getChapterBook } from "@/utils/content";
import HomeHero from "@/components/content/HomeHero.astro";
import { generateWebsiteSchema } from "@/utils/schema";
import RecentChapters from '@/components/content/RecentChapters.astro';
import Footer from '@/components/Footer.astro';

const allChapters = await getAllChapters();
const books = [1, 2]
	.map((book) => ({
		book,
		chapters: allChapters.filter((chapter) => getChapterBook(chapter) === book),
	}))
	.filter(({ chapters }) => chapters.length > 0);
const structuredData = generateWebsiteSchema();
---
<BaseLayout schema={structuredData}>
	<SEO slot="seo" title="Home" description={siteConfig.description} />
	<h1 class="sr-only">{siteConfig.title}</h1>
	
	<HomeHero />
	<!-- <MastHead /> -->
	{books.map(({ book, chapters }) => (
		<RecentChapters chapters={chapters} sectionTitle={`Book ${book}`} />
	))}
	<Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
