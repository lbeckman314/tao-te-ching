---
import siteConfig from "@/site.config";
import { commitDate } from "@/utils/git";

export interface Props {
  meta?: string;
  annotation?: string;
}

const {
  meta = `Translation by ${siteConfig.translator}`,
} = Astro.props;

// Set by GitHub Actions to the commit being built; absent in local builds
const commit = process.env.GITHUB_SHA;
const repoUrl = siteConfig.repository?.url.replace(/\/+$/, "");
const commitUrl = repoUrl && (commit ? `${repoUrl}/commit/${commit}` : `${repoUrl}/commits/`);
// Falls back to the short hash if the commit's date can't be read
const commitLabel = commitDate ? `Updated ${commitDate}` : (commit?.slice(0, 7) ?? "Local build");
---

<footer class="border-border bg-background mt-12 border-t py-8 ">
  <div class="app-layout">
    <div class="flex flex-col items-center">
      <span class="block mb-3 text-xl font-semibold tracking-tight">
        {siteConfig.title}
      </span>
      <span class="text-muted-foreground text-balance tracking-wide text-sm text-center leading-relaxed" set:html={meta} />

      {siteConfig.rightsNotice && (
        <p class="font-ui text-muted-foreground text-xs text-center text-balance leading-relaxed max-w-md mx-auto mt-4">
          {siteConfig.rightsNotice}
        </p>
      )}
      {commitUrl && (
        <a
          href={commitUrl}
          target="_blank"
          rel="noopener"
          class="font-ui text-muted-foreground text-xs mt-4 link-hover"
          title={commit ? `${commit}` : "Local build"}
        >
          {commitLabel}
        </a>
      )}
    </div>
  </div>
</footer>
