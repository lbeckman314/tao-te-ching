---
import siteConfig from "@/site.config";

export interface Props {
  meta?: string;
  annotation?: string;
}

const {
  meta = `Translation by ${siteConfig.translator}`,
  annotation = siteConfig.annotation,
} = Astro.props;

// Set by GitHub Actions to the commit being built; absent in local builds
const commit = process.env.GITHUB_SHA;
const repoUrl = siteConfig.repository?.url.replace(/\/+$/, "");
const commitUrl = repoUrl && (commit ? `${repoUrl}/commit/${commit}` : `${repoUrl}/commits/`);
const commitLabel = commit ? `Built from commit ${commit.slice(0, 7)}` : "Local build";
---

<footer class="border-border mt-12 border-t py-8 ">
  <div class="app-layout">
    <div class="flex flex-col items-center">
      <span class="block mb-3 text-xl font-semibold tracking-tight">
        {siteConfig.author}<span class="text-primary font-normal">.</span>
      </span>
      <span class="font-code text-muted-foreground text-balance tracking-wide text-sm text-center leading-relaxed" set:html={meta} />
      {annotation && (
        <span class="font-annotation block text-primary max-w-70 md:max-w-80 mx-auto mt-6 text-xl md:text-2xl text-center -rotate-1 leading-snug">
          {annotation}
        </span>
      )}
      {siteConfig.rightsNotice && (
        <p class="font-ui text-muted-foreground text-xs text-center text-balance leading-relaxed max-w-md mx-auto mt-6">
          {siteConfig.rightsNotice}
        </p>
      )}
      {commitUrl && (
        <a
          href={commitUrl}
          target="_blank"
          rel="noopener"
          class="font-code text-muted-foreground text-xs mt-4 link-hover"
          title={commit ? `Built from commit ${commit}` : "Local build"}
        >
          {commitLabel}
        </a>
      )}
    </div>
  </div>
</footer>
