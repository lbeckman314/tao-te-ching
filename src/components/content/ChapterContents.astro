---
// Table of contents merged with each book's progress: every book is a collapsible
// section whose heading row shows how many of its chapters have been added, and whose
// list links to each chapter's place on the same page.
import siteConfig from "@/site.config";
import { type Book, type Chapter, getChapterAnchor } from "@/utils/content";
import { Icon } from "astro-icon/components";

type Props = {
  books: { book: Book; chapters: Chapter[] }[];
};

// Book 1 is chapters 1-37, Book 2 the rest (see getChapterBook)
const allTotal = siteConfig.totalChapters;
const bookTotals = allTotal && { 1: Math.min(37, allTotal), 2: Math.max(allTotal - 37, 0) };

// Published chapters only in builds; dev also counts drafts
const books = Astro.props.books.map(({ book, chapters }) => {
  const total = bookTotals ? bookTotals[book] : chapters.length;
  const added = Math.min(chapters.length, total);
  return {
    book,
    chapters,
    added,
    total,
    percent: total > 0 ? Math.round((added / total) * 100) : 100,
  };
});
---
<nav
  aria-label="Contents"
  id="chapter-contents"
  class="font-ui text-xs text-muted-foreground"
  data-pagefind-ignore
  data-scroll-top-after
>
  {books.map(({ book, chapters, added, total, percent }) => (
    <details class="contents-book" data-book={book} open>
      <summary class="contents-summary py-2 link-hover">
        <span class="font-code text-sm font-medium uppercase tracking-[0.15em]">Book {book}</span>
        <span class="tabular-nums">
          {added === total ? `All ${total} chapters` : `${added} of ${total} chapters`}
        </span>
        <progress
          class="contents-meter"
          value={added}
          max={total}
          aria-label={`Book ${book} chapters added`}
        >
          {percent}%
        </progress>
        <span class="tabular-nums text-right" aria-hidden="true">{percent}%</span>
        {added === total ? (
          <Icon name="tabler:square-check" is:inline class="contents-done text-green-600" size={12} role="img" aria-label={`Book ${book} complete`} />
        ) : (
          <span aria-hidden="true"></span>
        )}
        <Icon name="tabler:chevron-down" class="contents-chevron" size={14} aria-hidden="true" />
      </summary>
      <ul class="pt-1 pb-6 gap-x-6 columns-2 sm:columns-3">
        {chapters.map((chapter) => (
          <li class="break-inside-avoid">
            <a href={`#${getChapterAnchor(chapter)}`} class="block py-1 link-hover">
              {chapter.data.title}
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}
</nav>

<!--
  Inline so saved open/closed choices apply before first paint, and data-astro-rerun so
  it runs again after each client-side navigation swaps in a fresh copy of the markup.
-->
<script is:inline data-astro-rerun>
  (() => {
    for (const details of document.querySelectorAll("#chapter-contents details")) {
      const key = `contents-book-${details.dataset.book}`;

      try {
        if (localStorage.getItem(key) === "closed") details.open = false;
      } catch (_) {}

      details.addEventListener("toggle", () => {
        try {
          if (details.open) localStorage.removeItem(key);
          else localStorage.setItem(key, "closed");
        } catch (_) {}
      });
    }
  })();
</script>

<style>
  /* Fixed label columns keep both books' bars aligned */
  .contents-summary {
    display: grid;
    grid-template-columns: 4.75rem 7.25rem minmax(0, 1fr) 2.5rem 12px 14px;
    column-gap: 0.5rem;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .contents-summary::-webkit-details-marker {
    display: none;
  }

  /* Down while collapsed ("show"), up while open ("hide") */
  .contents-chevron {
    transition: transform 200ms ease;
  }

  .contents-book[open] .contents-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .contents-chevron {
      transition: none;
    }
  }

  /*
   * A heavier check than Tabler's default 2: its paths set stroke-width, so CSS overrides it
   * (the icon is is:inline so its paths are real children rather than a <use> copy)
   */
  .contents-done :global(*) {
    stroke-width: 2.5;
  }

  .contents-meter {
    width: 100%;
    min-width: 0;
    height: 2px;
    border: 0;
    border-radius: 1px;
    appearance: none;
    overflow: hidden;
    background: var(--border);
    color: var(--primary);
  }

  .contents-meter::-webkit-progress-bar {
    background: var(--border);
  }

  .contents-meter::-webkit-progress-value {
    background: var(--primary);
  }

  .contents-meter::-moz-progress-bar {
    background: var(--primary);
  }
</style>
