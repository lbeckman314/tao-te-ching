---
// Table of contents merged with each book's progress: beside each book's title,
// a bar shows how many of its chapters have been added, and a list links to each
// chapter's place on the same page.
import siteConfig from "@/site.config";
import { type Book, type Chapter, getChapterAnchor } from "@/utils/content";
import { Icon } from "astro-icon/components";

type Props = {
  books: { book: Book; chapters: Chapter[] }[];
};

// Book 1 is chapters 1-37, Book 2 the rest (see getChapterBook)
const allTotal = siteConfig.totalChapters;
const bookTotals = allTotal && { 1: Math.min(37, allTotal), 2: Math.max(allTotal - 37, 0) };

// Published chapters only in builds; dev also counts drafts
const books = Astro.props.books.map(({ book, chapters }) => {
  const total = bookTotals ? bookTotals[book] : chapters.length;
  const added = Math.min(chapters.length, total);
  return {
    book,
    chapters,
    added,
    total,
    percent: total > 0 ? Math.round((added / total) * 100) : 100,
  };
});
---
<nav
  aria-label="Contents"
  class="chapter-contents font-ui text-xs text-muted-foreground"
  data-pagefind-ignore
  data-scroll-top-after
>
  {books.map(({ book, chapters, added, total, percent }) => (
    <div class="contents-book">
      <div class="contents-progress py-2">
        <span class="font-code text-sm font-medium uppercase tracking-[0.15em]">Book {book}</span>
        <span class="text-border" aria-hidden="true">|</span>
        <span class="tabular-nums">
          {added === total ? `All ${total} chapters` : `${added} of ${total} chapters`}
        </span>
        <progress
          class="contents-meter"
          value={added}
          max={total}
          aria-label={`Book ${book} chapters added`}
        >
          {percent}%
        </progress>
        <span class="flex items-center justify-between gap-2">
          <span class="tabular-nums hidden sm:inline" aria-hidden="true">{percent}%</span>
          {added === total && (
            <Icon name="tabler:square-check" is:inline class="contents-done text-green-600" size={12} role="img" aria-label={`Book ${book} complete`} />
          )}
        </span>
      </div>
      <ul class="gap-x-6 columns-2 sm:columns-3">
        {chapters.map((chapter) => (
          <li class="break-inside-avoid">
            <a href={`#${getChapterAnchor(chapter)}`} class="block py-1 link-hover">
              {chapter.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  /*
   * Text columns fit their contents and never wrap; the bar takes what's left.
   * Subgrid shares the columns between books, so their bars line up.
   */
  .chapter-contents {
    display: grid;
    grid-template-columns: max-content max-content max-content minmax(0, 1fr) minmax(12px, max-content);
    column-gap: 0.5rem;
    row-gap: 1.5rem;
  }

  .contents-book,
  .contents-progress {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }

  .contents-book > :global(*) {
    grid-column: 1 / -1;
  }

  .contents-progress {
    white-space: nowrap;
  }

  /*
   * A heavier check than Tabler's default 2: its paths set stroke-width, so CSS overrides it
   * (the icon is is:inline so its paths are real children rather than a <use> copy)
   */
  .contents-done :global(*) {
    stroke-width: 2.5;
  }

  .contents-meter {
    width: 100%;
    min-width: 0;
    height: 2px;
    border: 0;
    border-radius: 1px;
    appearance: none;
    overflow: hidden;
    background: var(--border);
    color: var(--primary);
  }

  .contents-meter::-webkit-progress-bar {
    background: var(--border);
  }

  .contents-meter::-webkit-progress-value {
    background: var(--primary);
  }

  .contents-meter::-moz-progress-bar {
    background: var(--primary);
  }
</style>
