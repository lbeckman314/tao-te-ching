---
// ChapterFeed.astro
import { type Chapter } from "@/utils/content";
import SectionHeader from "@/components/SectionHeader.astro";
import ChapterTitle from "./ChapterTitle.astro";
import ChapterMeta from "./ChapterMeta.astro";

type Props = {
  chapters: Chapter[];
  sectionTitle?: string;
  sectionDesc?: string;
};

const {
  chapters,
  sectionTitle,
  sectionDesc,
} = Astro.props;

---

<section>
  {
    sectionTitle && <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  }

  {/* Chapters in this year */}
  {chapters.map((chapter) => (
    <div class="flex flex-col space-y-3 py-4 group hover:translate-x-2 transition-transform ease-fluid">
      <ChapterTitle chapter={chapter}
        class="text-lg md:text-xl font-medium text-balance leading-snug link-hover"/>
      {chapter.data.description && (
        <p class="text-sm italic leading-normal text-muted-foreground md:max-w-xl">
          {chapter.data.description}
        </p>
      )}
      <div class="post-meta flex flex-row items-baseline gap-2 text-xs text-muted-foreground">
        <ChapterMeta chapter={chapter} accentCategory showReadingTime />
      </div>
    </div>
  ))}
</section>