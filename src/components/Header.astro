---
import siteConfig from "@/site.config";
import { getAssetPath } from "@/utils/url";
import SunIcon from "@/assets/sun.svg";
import MoonIcon from "@/assets/moon.svg";
import GitHubIcon from "@/assets/github.svg";
import InfoCircleIcon from "@/assets/info-circle.svg";

const navIcons = { github: GitHubIcon, "info-circle": InfoCircleIcon };

const pathname = Astro.url.pathname;

// "Tao Te Ching · 道德经": the part after the dot is marked as Chinese. The title is
// smaller on phones so it fits beside the icons, and is cut off with "…" rather than
// overlapping them on very narrow screens.
const [titleMain, titleAlt] = siteConfig.title.split(" · ");

function isActive(url: string) {
  const href = getAssetPath(url);

  if (href === getAssetPath("/")) {
    return pathname === href;
  }

  return pathname.startsWith(href);
}
---

<header class="site-header sticky overflow-visible top-0 z-40 border-b border-border bg-background/85 backdrop-blur">
  <div class="app-layout flex min-h-16 items-center justify-between gap-4 py-3">
    <!-- Logo / Title -->
    <a href={getAssetPath("/")} class="site-title flex min-w-0 items-center gap-3">
      {
        siteConfig.showLogo && siteConfig.logo ? (
          <img
            src={getAssetPath(siteConfig.logo)}
            alt={siteConfig.title}
            class="h-8 w-auto"
          />
        ) : (
          <span class="text-foreground text-lg sm:text-2xl font-medium tracking-tight whitespace-nowrap overflow-hidden text-ellipsis">
            {titleMain}
            {titleAlt && (
              <>
                {" · "}
                <span lang="zh-Hans">{titleAlt}</span>
              </>
            )}
          </span>
        )
      }
    </a>

    <div class="nav-right flex flex-row items-center gap-3 sm:gap-4">
      <nav class="flex items-center gap-4 sm:gap-4 font-ui text-sm">
        {
          siteConfig.navigation.map((item) => {
            const Icon = item.icon && navIcons[item.icon];
            return (
              <a
                href={getAssetPath(item.url)}
                class:list={["nav-link link-hover tracking-wide header-link", { "header-link-icon": Icon }]}
                aria-current={isActive(item.url) ? "page" : undefined}
                title={Icon ? item.title : undefined}
              >
                {Icon ? (
                  <>
                    <Icon width={18} height={18} aria-hidden="true" />
                    <span class="sr-only">{item.title}</span>
                  </>
                ) : (
                  item.title
                )}
              </a>
            );
          })
        }

      {
        siteConfig.showThemeToggle && (
          <>
            {/* <div class="h-3.5 w-px bg-border shrink-0" aria-hidden="true"></div> */}

            {/* Shows the theme it switches to: a moon while light, a sun while dark (labels set in theme.ts) */}
            <button
              type="button"
              id="theme-toggle"
              class="theme-toggle"
              aria-label="Dark theme"
              aria-pressed="false"
              title="Switch to dark theme"
            >
              <MoonIcon class="theme-icon-moon" width={18} height={18} aria-hidden="true" />
              <SunIcon class="theme-icon-sun" width={18} height={18} aria-hidden="true" />
            </button>
          </>
        )
      }

      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;

    animation: header-shadow linear both;
    animation-timeline: scroll();
    animation-range: 0px 1px;
  }

  @keyframes header-shadow {
    from { box-shadow: none; }
    to {
      box-shadow:
        0 1px 12px 0
        color-mix(in srgb, var(--foreground) 8%, transparent);
    }
  }

  /* ── Header links ──────────────────────────────────── */
  /* Same soft background as the theme toggle on hover and press; a pill around text, a circle around an icon */
  .header-link {
    min-height: 2rem;
    padding-inline: 0.75rem;
    border-radius: 9999px;
    transition: color 200ms, background-color 200ms;
  }

  .header-link-icon {
    width: 2rem;
    justify-content: center;
    padding-inline: 0;
  }

  .header-link:hover,
  .header-link:active {
    background: var(--muted);
  }

  /* The background takes the place of nav-link's growing underline */
  .header-link::after {
    display: none;
  }

  /* ── Theme toggle ──────────────────────────────────── */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 9999px;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: color 200ms, background-color 200ms;
  }

  .theme-toggle:hover,
  .theme-toggle:active {
    color: var(--primary);
    background: var(--muted);
  }

  .theme-icon-sun,
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
</style>
